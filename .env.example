# Copy to .env (docker compose reads it automatically) and fill in HA_TOKEN.
# chmod 600 .env once it has a real token in it.

MQTT_HOST=iothub
MQTT_PORT=1883
CONTROL_TOPIC=home/controller/volumecontrol/volume_ctl_stepper/bar/control
STATE_TOPIC=home/controller/volumecontrol/volume_ctl_stepper/bar/state

# Home Assistant > your profile > Security > Long-Lived Access Tokens > Create Token
HA_TOKEN=

# host.docker.internal resolves to this machine via the extra_hosts entry in docker-compose.yml.
# Change this once HA moves to its own host.
HA_URL=ws://host.docker.internal:8123/api/websocket
HA_ENTITY=media_player.genelec_sam_controller_8340a_stereo_speaker_pair_genelec_sam_system
